{
  "name": "yieldstream-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "YieldStream: Multi-tenant Merkle dividend distributor application layer",
  "workspaces": [
    "packages/*",
    "indexer",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev": "npm run dev --workspace=apps/web",
    "start": "npm run start --workspace=apps/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.2"
  }
}
